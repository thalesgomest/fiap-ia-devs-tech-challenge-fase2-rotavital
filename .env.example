# ------------------------------------------------------------
# LLM - escolha um provedor: ollama | openai | anthropic | offline
# ------------------------------------------------------------
LLM_PROVIDER=ollama
# Se o provedor estiver indisponível, usa textos determinísticos em vez de falhar
LLM_FALLBACK_OFFLINE=1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120
# Avaliação extra das respostas por LLM-como-juiz (dobra o número de chamadas)
LLM_JUDGE=0

# Ollama (padrão, local e gratuito): ollama pull llama3.1:8b
#   llama3.1:8b -> 16 GB de RAM ou GPU com 6 GB+ de VRAM
#   llama3.2:3b -> máquinas com 8 GB de RAM ou GPU com 4 GB de VRAM
# Em máquina lenta, aumente LLM_TIMEOUT_S (ex.: 300). Detalhes em docs/llm.md
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Qualquer API compatível com OpenAI (OpenAI, Groq, OpenRouter, LM Studio, Gemini...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude (SDK oficial anthropic); credencial via ANTHROPIC_API_KEY ou `ant auth login`
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ------------------------------------------------------------
# Dados
# ------------------------------------------------------------
