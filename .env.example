# ------------------------------------------------------------
# LLM - escolha um provedor: ollama | openai | anthropic | offline
# ------------------------------------------------------------
LLM_PROVIDER=ollama
# No chat: 0 mostra falha da LLM; 1 permite contingência identificada como offline
LLM_FALLBACK_OFFLINE=0
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=300
# Avaliação extra das respostas por LLM-como-juiz (dobra o número de chamadas)
LLM_JUDGE=0

# Ollama local: mesmo Qwen3 4B Q4_K_M validado no projeto anterior
# Em máquina lenta, aumente LLM_TIMEOUT_S (ex.: 300). Detalhes em docs/llm.md
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_THINK=0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_SEED=2026
OLLAMA_KEEP_ALIVE=10m

# Qualquer API compatível com OpenAI (OpenAI, Groq, OpenRouter, LM Studio, Gemini...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude (SDK oficial anthropic); credencial via ANTHROPIC_API_KEY ou `ant auth login`
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ------------------------------------------------------------
# Dados
# ------------------------------------------------------------
# ROTAVITAL_SCENARIOS_DIR=scenarios
# ROTAVITAL_DB=data/rotavital.db
